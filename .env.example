# ==============================================================================
# MedTrack Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=medtrack
POSTGRES_USER=medtrack
POSTGRES_PASSWORD=medtrack
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medtrack
SPRING_DATASOURCE_USERNAME=medtrack
SPRING_DATASOURCE_PASSWORD=medtrack

# ------------------------------------------------------------------------------
# 2. Backend Security & JWT Authentication
# ------------------------------------------------------------------------------
# 256-bit / 512-bit secret key for HMAC-SHA512 token signing
MEDTRACK_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
MEDTRACK_JWT_EXPIRATION_MS=900000
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# 3. Networking & CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ------------------------------------------------------------------------------
# 4. Frontend Web App Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api/v1